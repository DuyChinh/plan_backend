# Port chạy server (mặc định 5001 hoặc port do hosting cấp tự động như Render/Railway)
PORT=5001

# Chuỗi kết nối MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.nmzxcny.mongodb.net/Plan?retryWrites=true&w=majority

# Danh sách URL Frontend được phép gọi API qua CORS (ngăn cách bằng dấu phẩy)
# Ví dụ khi deploy:
CLIENT_URL=https://your-frontend-app.vercel.app,http://localhost:3000
